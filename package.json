{
  "name": "androiddeck",
  "version": "1.8.1",
  "description": "真实 Android 虚拟设备、APK 安装和多点键盘映射",
  "main": "src/main.cjs",
  "private": true,
  "scripts": {
    "start": "./启动.command",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "test:integration": "electron . --integration-test",
    "build:demo": "python3 scripts/build-demo.py",
    "setup:runtime": "python3 scripts/setup-runtime.py",
    "legacy:start": "electron .",
    "build:native": "python3 scripts/build-native.py"
  },
  "devDependencies": {
    "electron": "44.5.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/fanjiashu/AndroidDeck.git"
  }
}
